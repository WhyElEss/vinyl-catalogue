# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Read with `format: raw`: write values as-is, without quotes.

# Image tag to run: the 7-character commit CI published, or "latest".
VINYL_TAG=latest

# Host port for the LAN. Compose substitutes it, so it may stay unset.
HOST_PORT=8097
TZ=America/Toronto

# Whose collection is shown (the Discogs user name). The collection must be
# public on Discogs.
DISCOGS_USER=

# Optional Discogs personal access token (discogs.com/settings/developers).
# Raises the API limit from 25 to 60 requests a minute (the first full read
# takes about half an hour without it). Nothing else needs it.
DISCOGS_TOKEN=

# How often every release is read again — details and covers, so a better
# scan uploaded to Discogs replaces ours (Go duration, at least 1h). New
# records also appear after any container restart.
SYNC_INTERVAL=24h

# Public origin, without a trailing slash; used in link previews.
BASE_URL=
